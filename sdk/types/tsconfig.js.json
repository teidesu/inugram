{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // every plugin is its own engine with its own global object, so two plugins declaring the same
    // top-level `const` is not a redeclaration. without this they share one script scope and the
    // collisions are reported instead of the drift we're here for
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    // a plain-js plugin checks the contract it calls, not its own helpers: demanding a jsdoc
    // annotation on every parameter would trade the check for ceremony. what stays on is
    // everything that can catch a member the contract doesn't declare
    "noImplicitAny": false,
    "noImplicitThis": false,
    // `catch (e) { e.code }` is the shape common.d.ts tells plugin authors to write
    "useUnknownInCatchVariables": false
  }
}
