diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiPacksAlert.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiPacksAlert.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiPacksAlert.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiPacksAlert.java
@@ -1515,6 +1515,16 @@ public class EmojiPacksAlert extends BottomSheet implements NotificationCenter.N
             } catch (Exception e) {
                 FileLog.e(e);
             }
+        } else if (id == 100) {
+            final int index = customEmojiPacks.stickerSets.indexOf(stickerSet);
+            desu.inugram.helpers.StickerSetHelper.refreshStickerSet(currentAccount, (FrameLayout) containerView, resourcesProvider, stickerSet, newSet -> {
+                if (index < 0 || index >= customEmojiPacks.stickerSets.size()) {
+                    return;
+                }
+                customEmojiPacks.stickerSets.set(index, newSet);
+                customEmojiPacks.putStickerSet(index, newSet);
+                customEmojiPacks.onUpdate();
+            });
         }
     }
 
@@ -1730,6 +1740,7 @@ public class EmojiPacksAlert extends BottomSheet implements NotificationCenter.N
                 addView(optionsButton, LayoutHelper.createFrame(40, 40, Gravity.TOP | Gravity.RIGHT, 0, 5, 5 - backgroundPaddingLeft / AndroidUtilities.density, 0));
