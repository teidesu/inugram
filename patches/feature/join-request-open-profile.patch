 .../ui/Delegates/MemberRequestsDelegate.java    | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Delegates/MemberRequestsDelegate.java b/TMessagesProj/src/main/java/org/telegram/ui/Delegates/MemberRequestsDelegate.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Delegates/MemberRequestsDelegate.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Delegates/MemberRequestsDelegate.java
@@ -814,6 +814,23 @@ public class MemberRequestsDelegate implements MemberRequestCell.OnClickListener
             });
             popupLayout.addView(sendMsgCell);
 
+            ActionBarMenuSubItem openProfileCell = new ActionBarMenuSubItem(context, false, false, resourcesProvider);
+            openProfileCell.setColorKeys(Theme.key_actionBarDefaultSubmenuItem, Theme.key_actionBarDefaultSubmenuItemIcon);
+            openProfileCell.setSelectorColorKey(Theme.key_dialogButtonSelector, 1f);
+            openProfileCell.setTextAndIcon(LocaleController.getString(R.string.OpenProfile), R.drawable.msg_openprofile);
+            openProfileCell.setOnClickListener((v) -> {
+                if (importer != null) {
+                    isNeedRestoreList = true;
+                    super.dismiss();
+                    fragment.dismissCurrentDialog();
+                    Bundle args = new Bundle();
+                    args.putLong("user_id", importer.user_id);
+                    args.putBoolean("removeFragmentOnChatOpen", false);
+                    fragment.presentFragment(new ProfileActivity(args));
+                }
+            });
+            popupLayout.addView(openProfileCell);
+
             ActionBarMenuSubItem dismissCell = new ActionBarMenuSubItem(context, false, true, resourcesProvider);
             dismissCell.setColorKeys(Theme.key_text_RedBold, Theme.key_text_RedRegular);
             dismissCell.setSelectorColorKey(Theme.key_dialogButtonSelector, 1f);
