+
+    public static Runnable inu_recoverWalletSecret(int currentAccount, String address, SecretPhrase words, Utilities.Callback2<SecretPhrase, String> onResult) {
+        final byte[] publicKey;
+        try {
+            publicKey = secretPhraseToPublicKey(words);
+        } catch (RuntimeException e) {
+            AndroidUtilities.runOnUIThread(() -> onResult.run(null, "INU_RECOVER_INVALID"));
+            return null;
+        }
+        final byte[] phrase = words.copyBytes();
+        final AtomicBoolean cancelled = new AtomicBoolean();
+        InuRecovery.queue.postRunnable(() -> {
+            if (cancelled.get()) {
+                Arrays.fill(phrase, (byte) 0);
+                return;
+            }
+            final HttpTransport transport = new HttpTransport(currentAccount);
+            long handle = 0;
+            SecretPhrase secret = null;
+            String error = null;
+            try {
+                handle = nativeCreate(currentAccount, address, publicKey, transport,
+                    ApplicationLoader.applicationContext.getCacheDir().getAbsolutePath() + "/inu-wallet-recovery");
+                final byte[] bytes = nativeInuRecoverWalletSecret(handle, phrase);
+                if (bytes == null) throw new IllegalStateException("INU_RECOVER_NOT_FOUND");
+                try {
+                    secret = new SecretPhrase(bytes);
+                } finally {
+                    Arrays.fill(bytes, (byte) 0);
+                }
+            } catch (RuntimeException e) {
+                error = errorMessage(e);
+            } finally {
+                Arrays.fill(phrase, (byte) 0);
+                if (handle != 0) nativeClose(handle);
+                transport.close();
+            }
+            final SecretPhrase result = secret;
+            final String failure = error;
+            AndroidUtilities.runOnUIThread(() -> {
+                try {
+                    onResult.run(result, failure);
+                } finally {
+                    if (result != null) result.close();
+                }
+            });
+        });
+        return () -> cancelled.set(true);
+    }
