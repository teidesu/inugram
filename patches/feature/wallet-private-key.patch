+extern "C" JNIEXPORT jboolean JNICALL
+Java_desu_inugram_helpers_wallet_WalletKeyHelper_nativeIsPrivateKey(JNIEnv *env, jclass, jbyteArray secret_phrase) {
+    if (!secret_phrase) return JNI_FALSE;
+    try {
+        SensitiveString phrase(static_cast<size_t>(env->GetArrayLength(secret_phrase)));
+        env->GetByteArrayRegion(secret_phrase, 0, static_cast<jsize>(phrase.value.size()), reinterpret_cast<jbyte *>(phrase.value.data()));
+        if (env->ExceptionCheck()) return JNI_FALSE;
+        return inu_is_private_key(phrase.value) ? JNI_TRUE : JNI_FALSE;
+    } catch (...) {
+        return JNI_FALSE;
+    }
+}
+
+extern "C" JNIEXPORT jbyteArray JNICALL
+Java_desu_inugram_helpers_wallet_WalletKeyHelper_nativeNormalizePrivateKey(JNIEnv *env, jclass, jbyteArray secret_phrase) {
+    if (!secret_phrase) return nullptr;
+    try {
+        SensitiveString phrase(static_cast<size_t>(env->GetArrayLength(secret_phrase)));
+        env->GetByteArrayRegion(secret_phrase, 0, static_cast<jsize>(phrase.value.size()), reinterpret_cast<jbyte *>(phrase.value.data()));
+        if (env->ExceptionCheck() || !inu_is_private_key(phrase.value)) return nullptr;
+        constexpr auto reason = we::SecretAccessReason::kSignTonConnectProof;
+        auto host = std::make_shared<EphemeralWalletHost>(reason);
+        ImportProofRequest request(phrase.value);
+        auto descriptor = we::WalletLifecycle::init(host)->import_wallet(request.value);
+        auto bytes = host->read_protected_secret({descriptor.secret_ref, reason, ""});
+        auto result = env->NewByteArray(static_cast<jsize>(bytes.size()));
+        if (result) env->SetByteArrayRegion(result, 0, static_cast<jsize>(bytes.size()),
+                                           reinterpret_cast<const jbyte *>(bytes.data()));
+        volatile uint8_t *wipe = bytes.data();
+        for (size_t i = 0; i < bytes.size(); ++i) wipe[i] = 0;
+        return result;
+    } catch (const we::wallet_lifecycle_error::InvalidRecoveryPhrase &) {
+        return nullptr;
+    } catch (const std::bad_alloc &) {
+        throw_java(env, "java/lang/OutOfMemoryError", "Could not read private key");
+    } catch (...) {
+        throw_java(env, "java/lang/IllegalStateException", "Could not read private key");
+    }
+    return nullptr;
+}
+
+extern "C" JNIEXPORT jbyteArray JNICALL
+Java_org_telegram_ui_Wallet_WalletEngine2_nativeInuRecoverWalletSecret(JNIEnv *env, jclass, jlong handle, jbyteArray phrase_bytes) {
+    if (!phrase_bytes) return nullptr;
+    try {
+        auto client = get_client(handle);
+        SensitiveString phrase(static_cast<size_t>(env->GetArrayLength(phrase_bytes)));
+        env->GetByteArrayRegion(phrase_bytes, 0, static_cast<jsize>(phrase.value.size()), reinterpret_cast<jbyte *>(phrase.value.data()));
+        if (env->ExceptionCheck()) return nullptr;
+        ImportProofRequest request(phrase.value);
+        SensitiveString secret(0);
+        auto recovered = client.wallet->recover_wallet_secret(request.value.recovery_words);
+        secret.value.swap(recovered.phrase);
+        auto result = env->NewByteArray(static_cast<jsize>(secret.value.size()));
+        if (result) env->SetByteArrayRegion(result, 0, static_cast<jsize>(secret.value.size()),
+                                           reinterpret_cast<const jbyte *>(secret.value.data()));
+        return result;
+    } catch (const we::wallet_client_error::InvalidProtectedSecret &) {
+        throw_java(env, "java/lang/IllegalArgumentException", "INU_RECOVER_INVALID");
+    } catch (const we::wallet_client_error::EncryptedCommentLookupFailed &) {
+        throw_java(env, "java/lang/IllegalStateException", "INU_RECOVER_NOT_FOUND");
+    } catch (const we::wallet_client_error::WalletIdentityMismatch &) {
+        throw_java(env, "java/lang/IllegalStateException", "INU_RECOVER_REPLACED");
+    } catch (const std::bad_alloc &) {
+        throw_java(env, "java/lang/OutOfMemoryError", "Could not recover wallet secret");
+    } catch (const std::exception &error) {
+        throw_java(env, "java/lang/IllegalStateException", error.what());
+    } catch (...) {
+        throw_java(env, "java/lang/IllegalStateException", "Could not recover wallet secret");
+    }
+    return nullptr;
+}
