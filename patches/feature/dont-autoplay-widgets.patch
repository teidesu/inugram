+    public static boolean inu_isBlocked(String url) {
+        Entry entry = isWidgetUrl(url) ? entries.get(url) : null;
+        return entry != null && !WidgetSandboxSession.disabledByConfig() && !desu.inugram.helpers.chat.WidgetAutoplayHelper.mayRun(entry.storageKey());
+    }
+
+    public static void inu_onAutoplayDisabled() {
+        AndroidUtilities.runOnUIThread(() -> {
+            toMeasure.clear();
+            for (Entry entry : entries.values()) {
+                if (entry.message != null && entry.message.hasSession() && inu_isBlocked(entry.url)) entry.message.unload();
+            }
+        });
+    }
+
+    public static void inu_allow(String url) {
+        Entry entry = isWidgetUrl(url) ? entries.get(url) : null;
+        if (entry != null) desu.inugram.helpers.chat.WidgetAutoplayHelper.allow(entry.storageKey());
+    }
+
