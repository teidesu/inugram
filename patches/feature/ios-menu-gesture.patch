diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarMenuItem.java b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarMenuItem.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarMenuItem.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarMenuItem.java
@@ -331,8 +331,9 @@ public class ActionBarMenuItem extends FrameLayout {
             if (showMenuRunnable != null && !isInside(event, ViewConfiguration.get(getContext()).getScaledTouchSlop())) {
                 cancelShowMenuByLongPress();
             }
-            if (showSubmenuByMove && !overlayMenu && hasSubMenu() && !popupShown) {
+            if (showSubmenuByMove && hasSubMenu() && !popupShown && !overlayShown) {
                 if (event.getY() > getHeight()) {
+                    cancelShowMenuByLongPress();
                     if (getParent() != null) {
                         getParent().requestDisallowInterceptTouchEvent(true);
                     }
@@ -346,8 +347,7 @@ public class ActionBarMenuItem extends FrameLayout {
         } else if (event.getActionMasked() == MotionEvent.ACTION_UP && (popupShown || overlayShown)) {
             cancelShowMenuByLongPress();
             if (selectedMenuView != null) {
-                selectedMenuView.setSelected(false);
-                selectedMenuView.setPressed(false);
+                desu.inugram.helpers.LongPressDragMenuHelper.setHover(selectedMenuView, false);
                 final View selected = selectedMenuView;
                 final Object tag = selected.getTag();
                 selectedMenuView = null;
@@ -384,8 +384,7 @@ public class ActionBarMenuItem extends FrameLayout {
                 cancelShowMenuByLongPress();
             }
             if (selectedMenuView != null) {
-                selectedMenuView.setSelected(false);
-                selectedMenuView.setPressed(false);
+                desu.inugram.helpers.LongPressDragMenuHelper.setHover(selectedMenuView, false);
                 selectedMenuView = null;
             }
         }
@@ -411,7 +410,7 @@ public class ActionBarMenuItem extends FrameLayout {
         getLocationOnScreen(location);
         final float screenX = event.getX() + location[0];
         final float screenY = event.getY() + location[1];
-        selectedMenuView = null;
+        View hit = null;
         for (int a = 0; a < popupLayout.getItemsCount(); a++) {
             View child = popupLayout.getItemAt(a);
             Object tag = child.getTag();
@@ -425,20 +424,17 @@ public class ActionBarMenuItem extends FrameLayout {
             final float x = screenX - location[0];
             final float y = screenY - location[1];
             child.getHitRect(rect);
-            if (child.getVisibility() != VISIBLE || !rect.contains((int) x, (int) y)) {
-                child.setPressed(false);
-                child.setSelected(false);
-                if (Build.VERSION.SDK_INT == 21 && child.getBackground() != null) {
-                    child.getBackground().setVisible(false, false);
-                }
-            } else {
-                child.setPressed(true);
-                child.setSelected(true);
-                if (Build.VERSION.SDK_INT == 21 && child.getBackground() != null) {
-                    child.getBackground().setVisible(true, false);
-                }
-                child.drawableHotspotChanged(x - child.getLeft(), y - child.getTop());
-                selectedMenuView = child;
+            if (child.getVisibility() == VISIBLE && rect.contains((int) x, (int) y)) {
+                hit = child;
+            }
+        }
+        if (hit != selectedMenuView) {
+            if (selectedMenuView != null) {
+                desu.inugram.helpers.LongPressDragMenuHelper.setHover(selectedMenuView, false);
+            }
+            selectedMenuView = hit;
+            if (hit != null) {
+                desu.inugram.helpers.LongPressDragMenuHelper.setHover(hit, true, getShownSubMenuOverlay() == null, false);
             }
         }
     }
