+
+// --- shadowhook (libshadowhook.so) ---
+// unpacked from the aar instead of depended on. `implementation` would put it on the variant's
+// runtime classpath, where `checkAarMetadata` enforces the `minCompileSdk=37` its manifest carries -
+// and 37 is a *minor-versioned* platform (android-37.0) that AGP 8.6.1 predates and cannot resolve.
+// Nothing links or imports the aar's classes.jar, so resolving it in a configuration of our own
+// leaves that check with nothing to check and the .so is all that ships. Drop this block for a
+// plain `implementation` once AGP is new enough to resolve android-37.0.
+def shadowhookJniLibsDir = file("$buildDir/shadowhookJniLibs")
+
+tasks.register('unpackShadowhook', Copy) {
+    // both: libshadowhook.so dlopens libshadowhook_nothing.so for its hook trampolines
+    from({ zipTree(configurations.shadowhookAar.singleFile) }) {
+        include 'jni/**/libshadowhook.so'
+        include 'jni/**/libshadowhook_nothing.so'
+        eachFile { it.path = it.path.replaceFirst('^jni/', '') }
+        includeEmptyDirs = false
+    }
+    into shadowhookJniLibsDir
+}
+
+android.sourceSets.main.jniLibs.srcDirs += shadowhookJniLibsDir
+tasks.matching { it.name ==~ /merge.*JniLibFolders/ }.configureEach {
+    dependsOn 'unpackShadowhook'
+}
+
+// --- inugram rust plugin engine (libinu_native.so) ---
+// builds the standalone rquickjs/quickjs-ng cdylib via cargo-ndk and packages it as a jniLib.
+// build-env prerequisites: rustup + `rustup target add aarch64-linux-android`,
+// `cargo install cargo-ndk`, and libclang (NDK-provided) for rquickjs' bindgen.
+def rustModuleDir = file("$projectDir/native")
+def rustJniLibsDir = file("$buildDir/rustJniLibs")
+
+// gradle (launched from Android Studio / a daemon) doesn't inherit the login shell PATH, so cargo
+// isn't found by name. resolve the cargo binary from the usual toolchain locations, and prepend its
+// dir + ~/.cargo/bin (where `cargo install cargo-ndk` lands the subcommand) to the task PATH.
+// override with -Pcargo.bin=/path/to/cargo or the CARGO env var if your setup differs.
+def userHome = System.getProperty('user.home')
+def cargoHome = System.getenv('CARGO_HOME') ?: "$userHome/.cargo"
+def cargoCandidates = [
+    System.getenv('CARGO'),
+    project.findProperty('cargo.bin'),
+    "$cargoHome/bin/cargo",
+    "$userHome/.cargo/bin/cargo",
+    "/etc/profiles/per-user/${System.getProperty('user.name')}/bin/cargo", // nix per-user profile
+    "$userHome/.nix-profile/bin/cargo",                                     // nix home-manager
+    "/run/current-system/sw/bin/cargo",                                     // nixos system profile
+    "/opt/homebrew/bin/cargo",
+    "/usr/local/bin/cargo",
+]
+def cargoFile = cargoCandidates.findAll { it }.collect { file(it) }.find { it.isFile() }
+def cargoExe = cargoFile?.absolutePath ?: 'cargo'
+def cargoPathDirs = [cargoFile?.parentFile?.absolutePath, "$cargoHome/bin", "$userHome/.cargo/bin"].findAll { it }
+
+tasks.register('buildInuNative', Exec) {
+    workingDir rustModuleDir
+    environment 'ANDROID_NDK_HOME', android.ndkDirectory.absolutePath
+    environment 'PATH', (cargoPathDirs + [System.getenv('PATH') ?: '']).join(File.pathSeparator)
+    // bindgen needs *a* libclang to parse the quickjs headers (the android target/sysroot is supplied
+    // separately by cargo-ndk). NDK r27+ no longer ships libclang.dylib, so search the NDK first, then
+    // fall back to system libclang locations. override with -Plibclang.path=/dir if none are found.
+    def prebuilt = file("${android.ndkDirectory}/toolchains/llvm/prebuilt")
+    def ndkHost = prebuilt.listFiles()?.find { it.isDirectory() }
+    def libclangCandidates = [
+        project.findProperty('libclang.path'),
+        ndkHost ? new File(ndkHost, 'lib').absolutePath : null,
+        ndkHost ? new File(ndkHost, 'lib64').absolutePath : null,
+        '/Library/Developer/CommandLineTools/usr/lib',                 // xcode command line tools
+        '/opt/homebrew/opt/llvm/lib', '/usr/local/opt/llvm/lib',       // homebrew llvm
+        '/run/current-system/sw/lib', "${System.getProperty('user.home')}/.nix-profile/lib", // nix
+        '/usr/lib/llvm/lib', '/usr/lib',                               // linux distros
+    ]
+    def libclangDir = libclangCandidates.findAll { it }.find { dir ->
+        def d = file(dir)
+        d.isDirectory() && d.listFiles()?.any { it.name ==~ /libclang\.(dylib|so)(\..*)?/ }
+    }
+    if (libclangDir != null) environment 'LIBCLANG_PATH', libclangDir
+    commandLine cargoExe, 'ndk', '-t', 'arm64-v8a', '-o', rustJniLibsDir.absolutePath, 'build', '--release'
+}
+
+android.sourceSets.main.jniLibs.srcDirs += rustJniLibsDir
+tasks.matching { it.name ==~ /merge.*JniLibFolders/ }.configureEach {
+    dependsOn 'buildInuNative'
+}
