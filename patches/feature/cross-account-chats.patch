+                continue;
+            }
+            boolean last = i + 1 >= itemInternals.size() || itemInternals.get(i + 1).viewType != VIEW_TYPE_DIALOG;
+            if (!item.pinned && !item.isFolder) {
+                while (next < linked.size() && linked.get(next).last_message_date >= item.dialog.last_message_date) {
+                    itemInternals.add(i++, new ItemInternal(linked.get(next++)));
+                }
+            }
+            if (last) {
+                while (next < linked.size()) {
+                    itemInternals.add(++i, new ItemInternal(linked.get(next++)));
+                }
+            }
+        }
+        if (next < linked.size() && isEmpty) {
+            for (int i = 0; i < itemInternals.size(); i++) {
+                if (itemInternals.get(i).viewType != VIEW_TYPE_EMPTY) {
+                    continue;
+                }
+                isEmpty = false;
+                itemInternals.remove(i);
+                while (next < linked.size()) {
+                    itemInternals.add(i++, new ItemInternal(linked.get(next++)));
+                }
+                if (i == itemInternals.size()) {
+                    itemInternals.add(new ItemInternal(VIEW_TYPE_LAST_EMPTY));
+                }
+                break;
+            }
+        }
