     public static void openUrl(final Context context, Uri uri, boolean _allowCustom, boolean tryTelegraph, boolean forceNotInternalForApps, Progress inCaseLoading, String browser, boolean allowIntent, boolean allowInAppBrowser, boolean forceRequest, boolean keepWebAuthTokens) {
+        if (context != null && uri != null && desu.inugram.helpers.UrlCleanerHelper.openResolvingRedirects(context, uri, inCaseLoading, resolved -> inu_openUrl(context, resolved, _allowCustom, tryTelegraph, forceNotInternalForApps, null, browser, allowIntent, allowInAppBrowser, forceRequest, keepWebAuthTokens))) {
+            return;
+        }
+        inu_openUrl(context, uri, _allowCustom, tryTelegraph, forceNotInternalForApps, inCaseLoading, browser, allowIntent, allowInAppBrowser, forceRequest, keepWebAuthTokens);
+    }
+
+    private static void inu_openUrl(final Context context, Uri uri, boolean _allowCustom, boolean tryTelegraph, boolean forceNotInternalForApps, Progress inCaseLoading, String browser, boolean allowIntent, boolean allowInAppBrowser, boolean forceRequest, boolean keepWebAuthTokens) {
         if (context == null || uri == null) {
             return;
         }
         if (!keepWebAuthTokens) {
             uri = withoutWebAuthTokens(uri);
         }
+        uri = desu.inugram.helpers.UrlCleanerHelper.clean(uri);
         final int currentAccount = UserConfig.selectedAccount;
         boolean[] forceBrowser = new boolean[]{false};
         boolean internalUri = isInternalUri(uri, forceBrowser);
