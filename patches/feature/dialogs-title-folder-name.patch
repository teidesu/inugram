+    public MessagesController.DialogFilter inu_getCurrentFilter() {
+        if (viewPages == null) return null;
+        ArrayList<MessagesController.DialogFilter> filters = getMessagesController().getDialogFilters();
+        int index = viewPages[0].selectedType;
+        return index >= 0 && index < filters.size() ? filters.get(index) : null;
+    }
+
+    private void inu_updateFolderTitle() {
+        if (desu.inugram.InuConfig.DIALOGS_TITLE_TEXT.getValue() != desu.inugram.InuConfig.DialogsTitleTextItem.FOLDER_NAME) return;
+        if (actionBar != null && !onlySelect && folderId == 0 && communityId == 0 && !desu.inugram.helpers.security.ParanoiaHelper.isDisguised()) {
+            String title = desu.inugram.helpers.chat.ChatHelper.getDialogsTitle(this, currentAccount);
+            SimpleTextView titleView = actionBar.getTitleTextView();
+            if (titleView == null || !TextUtils.equals(titleView.getText(), title)) {
+                if (titleView != null && titleView.getVisibility() == View.VISIBLE && titleView.getAlpha() == 1f) {
+                    actionBar.setTitleAnimated(title, animatingForward, 220, CubicBezierInterpolator.DEFAULT);
+                }
+                actionBar.setTitle(title, statusDrawable);
+            }
+        }
+        if (dialogStoriesCell != null) {
+            dialogStoriesCell.updateItems(true, false);
+        }
+    }
+
     public void inu_setActiveFilter(int filterIndex) {
