+            return;
+        }
+        AlertsCreator.ensurePaidMessageConfirmation(currentAccount, getDialogId(), 1, price -> {
+            if (chatMode == MODE_SCHEDULED) {
+                AlertsCreator.createScheduleDatePickerDialog(getParentActivity(), dialog_id, (notify, scheduleDate, scheduleRepeatPeriod) -> inu_sendBotInlineResult(result, notify, scheduleDate, price, true), themeDelegate);
+            } else {
+                inu_sendBotInlineResult(result, true, 0, price, true);
+            }
+        });
+    }
