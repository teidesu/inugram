diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/SharedConfig.java b/TMessagesProj/src/main/java/org/telegram/messenger/SharedConfig.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/SharedConfig.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/SharedConfig.java
@@ -1392,7 +1392,8 @@ public class SharedConfig {
 
     /** Compact mode of a dialog: the app's setting, and agent bot chats are always compact. */
     public static boolean isCompactMode(int currentAccount, long dialogId) {
-        return compactMode || dialogId > 0 && AppGlobalConfig.getInstance(currentAccount).agentBotIds.contains(dialogId);
+        return compactMode || dialogId > 0 && AppGlobalConfig.getInstance(currentAccount).agentBotIds.contains(dialogId)
+            || desu.inugram.helpers.chat.CompactModeHelper.isEnabledFor(currentAccount, dialogId);
     }
 
     public static void toggleCompactMode() {
