+void ConnectionsManager::inu_replaceNotSentRequest(int32_t token, NativeByteBuffer *data, std::function<void(bool)> onDone) {
+    scheduleTask([&, token, data, onDone] {
+        for (auto queue : {&requestsQueue, &waitingLoginRequests}) {
+            for (auto &request : *queue) {
+                if (request->requestToken != token) {
+                    continue;
+                }
+                auto apiRequest = dynamic_cast<TL_api_request *>(request->rawRequest);
+                if (request->cancelled || request->inu_sent || apiRequest == nullptr) {
+                    break;
+                }
+                apiRequest->request->reuse();
+                apiRequest->request = data;
+                onDone(true);
+                return;
+            }
+        }
+        data->reuse();
+        onDone(false);
+    });
+}
