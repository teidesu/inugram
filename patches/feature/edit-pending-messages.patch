+    private final ConcurrentHashMap<Integer, Utilities.Callback<Boolean>> inu_replaceCallbacks = new ConcurrentHashMap<>();
+
+    public void inu_replaceNotSentRequest(int requestToken, TLObject object, Utilities.Callback<Boolean> onDone) {
+        Utilities.stageQueue.postRunnable(() -> {
+            NativeByteBuffer buffer;
+            try {
+                buffer = new NativeByteBuffer(object.getObjectSize());
+                object.serializeToStream(buffer);
+            } catch (Exception e) {
+                FileLog.e(e);
+                onDone.run(false);
+                return;
+            }
+            int callbackId = lastRequestToken.getAndIncrement();
+            inu_replaceCallbacks.put(callbackId, onDone);
+            native_inu_replaceNotSentRequest(currentAccount, requestToken, buffer.address, callbackId);
+        });
+    }
+
+    public static void inu_onRequestReplaced(int currentAccount, int callbackId, boolean replaced) {
+        Utilities.Callback<Boolean> onDone = getInstance(currentAccount).inu_replaceCallbacks.remove(callbackId);
+        if (onDone != null) {
+            onDone.run(replaced);
+        }
+    }
