From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alina sireneva <alina@tei.su>
Date: Mon, 27 Apr 2026 09:46:28 +0300
Subject: hooks for the app loader: our own ApplicationLoaderImpl, and the boot point at the tail of postInitApplication

---
 .../java/org/telegram/messenger/ApplicationLoader.java    | 8 ++++++++
 TMessagesProj_App/src/main/AndroidManifest.xml            | 2 +-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java b/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ApplicationLoader.java
@@ -272,6 +272,12 @@ public class ApplicationLoader extends Application {
             DownloadController.getInstance(a);
         }
         BillingController.getInstance().startConnection();
+
+        try {
+            desu.inugram.InuHooks.onAppBoot();
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
     }
 
     public ApplicationLoader() {
@@ -291,6 +297,7 @@ public class ApplicationLoader extends Application {
 
         // AndroidUtilities must be initialized before FileLog
         final String helloWorld = AndroidUtilities.getHelloWorld();
+        desu.inugram.InuHooks.preInit(this);
 
         if (BuildVars.LOGS_ENABLED) {
             FileLog.d(helloWorld);
@@ -348,6 +355,7 @@ public class ApplicationLoader extends Application {
         }
 
         applicationHandler = new Handler(applicationContext.getMainLooper());
+        desu.inugram.InuHooks.init(this);
 
         AndroidUtilities.runOnUIThread(ApplicationLoader::startPushService);
 
diff --git a/TMessagesProj_App/src/main/AndroidManifest.xml b/TMessagesProj_App/src/main/AndroidManifest.xml
index 0000000..0000000 100644
--- a/TMessagesProj_App/src/main/AndroidManifest.xml
+++ b/TMessagesProj_App/src/main/AndroidManifest.xml
@@ -3,7 +3,7 @@
     xmlns:tools="http://schemas.android.com/tools"
     android:installLocation="auto">
 
-    <application android:name="org.telegram.messenger.ApplicationLoaderImpl" tools:replace="name">
+    <application android:name="desu.inugram.ApplicationLoaderImpl" tools:replace="name">
         <service
             android:name="org.telegram.messenger.GoogleVoiceClientService"
             android:exported="true"
