 .../src/main/java/org/telegram/messenger/MessagesStorage.java | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesStorage.java
@@ -19349,7 +19349,7 @@ public class MessagesStorage extends BaseController {
         return isForum(dialogId, FORUM_TYPE_DIRECT);
     }
 
-    private int getForumTypeFlags(long dialogId) {
+    private synchronized int getForumTypeFlags(long dialogId) {
         int value = dialogIsForumTyped.get(dialogId, -1);
         if (value == -1) {
             value = 0;
@@ -19389,7 +19389,7 @@ public class MessagesStorage extends BaseController {
         return (value & type) != 0;
     }
 
-    public void isForumCacheInvalidate(long dialogId) {
+    public synchronized void isForumCacheInvalidate(long dialogId) {
         dialogIsForumTyped.delete(dialogId);
