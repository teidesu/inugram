 import org.telegram.messenger.MessageObject;
@@ -204,6 +205,7 @@ public class AudioPlayerCell extends FrameLayout implements DownloadController.F
                 radialProgress.setImageOverlay(null, null, null);
             }
         }
+        inu_loadId3Cover(false);
         requestLayout();
         updateButtonState(false, false);
     }
@@ -489,6 +491,22 @@ public class AudioPlayerCell extends FrameLayout implements DownloadController.F
     public void onSuccessDownload(String fileName) {
         radialProgress.setProgress(1, true);
         updateButtonState(false, true);
+        inu_loadId3Cover(true);
+    }
+
+    private void inu_loadId3Cover(boolean crossfade) {
+        final MessageObject messageObject = currentMessageObject;
+        desu.inugram.helpers.media.AudioCoverHelper.loadSmallCover(messageObject, cover -> {
+            if (currentMessageObject != messageObject) {
+                return;
+            }
+            final ImageReceiver overlay = radialProgress.overlayImageView;
+            overlay.setCrossfadeWithOldImage(crossfade);
+            overlay.setForceCrossfade(crossfade);
+            radialProgress.setImageOverlay(cover);
+            overlay.setCrossfadeWithOldImage(false);
+            overlay.setForceCrossfade(false);
+        });
     }
 
     @Override
