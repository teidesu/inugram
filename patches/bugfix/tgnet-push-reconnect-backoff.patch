From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: dreamer <353556243+dreamer4202@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:02:00 +0300
Subject: persistent connection: fix non-stop reconnects while the server is unreachable

---
 TMessagesProj/jni/tgnet/Connection.cpp         |  3 ++-
 TMessagesProj/jni/tgnet/ConnectionsManager.cpp | 12 +++++++++++-
 TMessagesProj/jni/tgnet/ConnectionsManager.h   |  1 +
 3 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/jni/tgnet/Connection.cpp b/TMessagesProj/jni/tgnet/Connection.cpp
index 0000000..0000000 100644
--- a/TMessagesProj/jni/tgnet/Connection.cpp
+++ b/TMessagesProj/jni/tgnet/Connection.cpp
@@ -701,7 +701,8 @@ void Connection::onDisconnectedInternal(int32_t reason, int32_t error) {
             }
         }
         if (error == 0x68 || error == 0x71) {
-            if (connectionType != ConnectionTypeProxy) {
+            // the push connection is reconnected by the ping scheduler with a growing delay, never by this timer
+            if (connectionType != ConnectionTypeProxy && connectionType != ConnectionTypePush) {
                 waitForReconnectTimer = true;
                 reconnectTimer->setTimeout(lastReconnectTimeout, false);
                 lastReconnectTimeout *= 2;
diff --git a/TMessagesProj/jni/tgnet/ConnectionsManager.cpp b/TMessagesProj/jni/tgnet/ConnectionsManager.cpp
index 0000000..0000000 100644
--- a/TMessagesProj/jni/tgnet/ConnectionsManager.cpp
+++ b/TMessagesProj/jni/tgnet/ConnectionsManager.cpp
@@ -766,7 +766,10 @@ void ConnectionsManager::onConnectionClosed(Connection *connection, int reason)
     } else if (connection->getConnectionType() == ConnectionTypePush) {
         if (LOGS_ENABLED) DEBUG_D("connection(%p) push connection closed", connection);
         sendingPushPing = false;
-        lastPushPingTime = getCurrentTimeMonotonicMillis() - nextPingTimeOffset + 4000;
+        lastPushPingTime = getCurrentTimeMonotonicMillis() - nextPingTimeOffset + inu_pushReconnectDelay;
+        // every failed attempt doubles the wait instead of retrying every 4 seconds. The cap has to stay under two ping
+        // intervals: the checks take llabs() of a ping time that is then in the future, and would fire at once
+        inu_pushReconnectDelay = inu_pushReconnectDelay == 0 ? 4000 : std::min(inu_pushReconnectDelay * 2, 180000);
     } else if (connection->getConnectionType() == ConnectionTypeProxy) {
         scheduleTask([&, connection] {
             for (auto iter = proxyActiveChecks.begin(); iter != proxyActiveChecks.end(); iter++) {
@@ -1193,6 +1196,8 @@ void ConnectionsManager::processServerResponse(TLObject *message, int64_t messag
             currentPingTimeLive = (diff + currentPingTimeLive) / 2;
             if (LOGS_ENABLED) DEBUG_D("connection(%p, account%u, dc%u, type %d) received push ping", connection, instanceNum, datacenter->getDatacenterId(), connection->getConnectionType());
             sendingPushPing = false;
+            // a working connection: reconnect at once if it goes away, then back off
+            inu_pushReconnectDelay = 0;
         } else {
             auto response = (TL_pong *) message;
             if (response->ping_id >= 2000000) {
@@ -3945,6 +3950,11 @@ void ConnectionsManager::setNetworkAvailable(bool value, int32_t type, bool slow
         if (!networkAvailable) {
             connectionState = ConnectionStateWaitingForNetwork;
         } else {
+            if (pushConnectionEnabled) {
+                // a network change resets the backoff; the ping is marked as due, not timed out, so a healthy connection is kept
+                inu_pushReconnectDelay = 0;
+                lastPushPingTime = getCurrentTimeMonotonicMillis() - nextPingTimeOffset;
+            }
             for (auto & datacenter : datacenters) {
                 if (datacenter.second->isHandshaking(false)) {
                     datacenter.second->createGenericConnection()->connect();
diff --git a/TMessagesProj/jni/tgnet/ConnectionsManager.h b/TMessagesProj/jni/tgnet/ConnectionsManager.h
index 0000000..0000000 100644
--- a/TMessagesProj/jni/tgnet/ConnectionsManager.h
+++ b/TMessagesProj/jni/tgnet/ConnectionsManager.h
@@ -163,6 +163,7 @@ private:
     int32_t nextPingTimeOffset = 60000 * 3;
     int64_t sendingPushPingTime = 0;
     bool sendingPushPing = false;
+    int32_t inu_pushReconnectDelay = 4000;
     bool sendingPing = false;
     bool updatingDcSettings = false;
     bool updatingDcSettingsAgain = false;
