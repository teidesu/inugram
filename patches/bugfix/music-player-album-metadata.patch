+    private void inu_startMusicPlayerService() {
+        if (!canStartMusicPlayerService()) return;
+        try {
+            ApplicationLoader.applicationContext.startService(new Intent(ApplicationLoader.applicationContext, MusicPlayerService.class));
+        } catch (Throwable e) {
