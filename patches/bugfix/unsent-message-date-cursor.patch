+    private int inu_queryPositiveMessages(String aggregate, long dialogId, long threadMessageId, int fromMid, int toMid) throws SQLiteException {
+        SQLiteCursor cursor = null;
+        try {
+            if (threadMessageId != 0) {
+                cursor = database.queryFinalized(String.format(Locale.US, "SELECT %s FROM messages_topics WHERE uid = %d AND topic_id = %d AND mid >= %d AND mid <= %d", aggregate, dialogId, threadMessageId, Math.max(fromMid, 1), toMid));
+            } else {
+                cursor = database.queryFinalized(String.format(Locale.US, "SELECT %s FROM messages_v2 WHERE uid = %d AND mid >= %d AND mid <= %d", aggregate, dialogId, Math.max(fromMid, 1), toMid));
+            }
+            return cursor.next() ? cursor.intValue(0) : 0;
+        } finally {
+            if (cursor != null) {
+                cursor.dispose();
+            }
+        }
+    }
+
+    private SQLiteCursor inu_queryTrailingUnsent(String messageSelect, long dialogId, long threadMessageId, int pageMaxId, ArrayList<TLRPC.Message> loaded) throws SQLiteException {
+        if (pageMaxId <= 0 || pageMaxId != inu_queryPositiveMessages("max(mid)", dialogId, threadMessageId, 1, Integer.MAX_VALUE)) {
+            return null;
+        }
+        SQLiteCursor cursor = null;
+        try {
+            if (threadMessageId != 0) {
+                cursor = database.queryFinalized(String.format(Locale.US, "SELECT 1 FROM messages_holes_topics WHERE uid = %d AND topic_id = %d AND end > %d LIMIT 1", dialogId, threadMessageId, pageMaxId));
+            } else {
+                cursor = database.queryFinalized(String.format(Locale.US, "SELECT 1 FROM messages_holes WHERE uid = %d AND end > %d LIMIT 1", dialogId, pageMaxId));
+            }
+            if (cursor.next()) {
+                return null;
+            }
+        } finally {
+            if (cursor != null) {
+                cursor.dispose();
+            }
+        }
+        StringBuilder loadedUnsent = new StringBuilder();
+        for (TLRPC.Message message : loaded) {
+            if (message.id < 0) {
+                if (loadedUnsent.length() > 0) {
+                    loadedUnsent.append(',');
+                }
+                loadedUnsent.append(message.id);
+            }
+        }
+        String condition = "m.mid < 0 AND m.date >= " + inu_queryPositiveMessages("max(date)", dialogId, threadMessageId, pageMaxId, pageMaxId) + (loadedUnsent.length() > 0 ? " AND m.mid NOT IN(" + loadedUnsent + ")" : "");
+        if (threadMessageId != 0) {
+            return database.queryFinalized(String.format(Locale.US, messageSelect + " WHERE m.uid = %d AND m.topic_id = %d AND " + condition, dialogId, threadMessageId));
+        }
+        return database.queryFinalized(String.format(Locale.US, messageSelect + " WHERE m.uid = %d AND " + condition, dialogId));
+    }
+
