+        private int inu_calculatePaddingTop(float filterTabsVisibility) {
+            int t = ActionBar.getCurrentActionBarHeight() + (actionBar.getOccupyStatusBar() ? AndroidUtilities.statusBarHeight : 0);
+            if (hasStories && !actionModeFullyShowed) {
+                t += dp(DialogStoriesCell.HEIGHT_IN_DP);
+            }
+            if (!actionModeFullyShowed && !NonIslandHelper.globalSearch()) {
+                t += dp(SEARCH_FIELD_HEIGHT);
+            }
+
+            final float topPanelsVisibility = topPanelLayout != null ? topPanelLayout.getMetadata().getTotalVisibility() : 0f;
+
+            t += (int) ((NonIslandHelper.foldersBar() ? NonIslandHelper.getFoldersBarVisibleHeight() : dp(36 + 14)) * filterTabsVisibility);
+
+            if (topPanelLayout != null) {
+                t += (int) topPanelLayout.getAnimatedHeightWithPadding(NonIslandHelper.foldersBar() ? 0f : lerp((float) dp(14), dp(7), filterTabsVisibility));
+            }
+
+            if (!NonIslandHelper.foldersBar()) {
+                t -= dp(5 * Math.max(filterTabsVisibility, topPanelsVisibility));
+            }
+            return t;
+        }
