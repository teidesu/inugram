+    private static void mergeMessageReactionUpdates(ArrayList<TLRPC.Update> updates) {
+        for (int a = 0, size = updates.size(); a < size; a++) {
+            TLRPC.Update baseUpdate = updates.get(a);
+            TLRPC.Message message;
+            if (baseUpdate instanceof TL_update.TL_updateEditChannelMessage) {
+                message = ((TL_update.TL_updateEditChannelMessage) baseUpdate).message;
+            } else if (baseUpdate instanceof TL_update.TL_updateEditMessage) {
+                message = ((TL_update.TL_updateEditMessage) baseUpdate).message;
+            } else {
+                continue;
+            }
+            long dialogId = MessageObject.getDialogId(message);
+            for (int b = 0; b < size; b++) {
+                if (updates.get(b) instanceof TL_update.TL_updateMessageReactions) {
+                    TL_update.TL_updateMessageReactions update = (TL_update.TL_updateMessageReactions) updates.get(b);
+                    if (message.id == update.msg_id && dialogId == MessageObject.getPeerId(update.peer)) {
+                        if (desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled()) {
+                            FileLog.d("InuRx merge edit reactions did=" + dialogId + " mid=" + message.id + " edit=" + desu.inugram.helpers.chat.ReactionDebugHelper.describe(message.reactions) + " update=" + desu.inugram.helpers.chat.ReactionDebugHelper.describe(update.reactions));
+                        }
+                        MessageObject.updateReactions(message, update.reactions);
+                    }
+                }
+            }
+        }
+    }
+
