+    public static class inu_SentReactions {
+        final String key;
+        final ArrayList<TLRPC.ReactionCount> chosen = new ArrayList<>();
+        final ArrayList<TLRPC.MessagePeerReaction> own = new ArrayList<>();
+        volatile long until = SystemClock.elapsedRealtime() + 15000;
+
+        inu_SentReactions(String key) {
+            this.key = key;
+        }
+    }
+
+    private final ConcurrentHashMap<String, inu_SentReactions> inu_sentReactions = new ConcurrentHashMap<>();
+
+    public inu_SentReactions inu_trackSentReactions(long dialogId, int messageId, TLRPC.MessageReactions local) {
+        inu_SentReactions sent = new inu_SentReactions(dialogId + "_" + messageId);
+        if (local != null) {
+            final long selfId = getUserConfig().getClientUserId();
+            for (int i = 0; i < local.results.size(); i++) {
+                TLRPC.ReactionCount result = local.results.get(i);
+                if (result.chosen) {
+                    TLRPC.TL_reactionCount copy = new TLRPC.TL_reactionCount();
+                    copy.flags = 1;
+                    copy.chosen = true;
+                    copy.chosen_order = result.chosen_order;
+                    copy.reaction = result.reaction;
+                    copy.count = result.count;
+                    sent.chosen.add(copy);
+                }
+            }
+            for (int i = 0; i < local.recent_reactions.size(); i++) {
+                TLRPC.MessagePeerReaction reaction = local.recent_reactions.get(i);
+                if (MessageObject.getPeerId(reaction.peer_id) == selfId && inu_findReactionCount(sent.chosen, reaction.reaction) != null) {
+                    TLRPC.TL_messagePeerReaction copy = new TLRPC.TL_messagePeerReaction();
+                    copy.flags = reaction.flags & ~2;
+                    copy.big = reaction.big;
+                    copy.peer_id = reaction.peer_id;
+                    copy.reaction = reaction.reaction;
+                    copy.date = reaction.date;
+                    sent.own.add(copy);
+                }
+            }
+        }
+        inu_sentReactions.put(sent.key, sent);
+        return sent;
+    }
+
+    public void inu_finishSentReactions(inu_SentReactions sent, boolean ok) {
+        if (ok) {
+            sent.until = SystemClock.elapsedRealtime() + 10000;
+        } else {
+            inu_sentReactions.remove(sent.key, sent);
+        }
+    }
+
+    private static TLRPC.ReactionCount inu_findReactionCount(ArrayList<TLRPC.ReactionCount> results, TLRPC.Reaction reaction) {
+        for (int i = 0; i < results.size(); i++) {
+            if (ReactionsLayoutInBubble.equalsTLReaction(results.get(i).reaction, reaction)) {
+                return results.get(i);
+            }
+        }
+        return null;
+    }
+
+    public void inu_keepSentReactions(long dialogId, int messageId, TLRPC.TL_messageReactions reactions) {
+        final String key = dialogId + "_" + messageId;
+        inu_SentReactions sent = inu_sentReactions.get(key);
+        if (sent == null || reactions == null || reactions.min) {
+            return;
+        }
+        if (SystemClock.elapsedRealtime() > sent.until) {
+            inu_sentReactions.remove(key, sent);
+            return;
+        }
+        final boolean debug = desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled();
+        final String before = debug ? desu.inugram.helpers.chat.ReactionDebugHelper.describe(reactions) : null;
+        boolean changed = false;
+        for (int i = reactions.results.size() - 1; i >= 0; i--) {
+            TLRPC.ReactionCount result = reactions.results.get(i);
+            if (result.chosen && inu_findReactionCount(sent.chosen, result.reaction) == null) {
+                result.chosen = false;
+                result.flags &= ~1;
+                result.count--;
+                if (result.count <= 0) {
+                    reactions.results.remove(i);
+                }
+                changed = true;
+            }
+        }
+        for (int i = 0; i < sent.chosen.size(); i++) {
+            TLRPC.ReactionCount expected = sent.chosen.get(i);
+            TLRPC.ReactionCount result = inu_findReactionCount(reactions.results, expected.reaction);
+            if (result == null) {
+                TLRPC.TL_reactionCount copy = new TLRPC.TL_reactionCount();
+                copy.flags = 1;
+                copy.chosen = true;
+                copy.chosen_order = expected.chosen_order;
+                copy.reaction = expected.reaction;
+                copy.count = expected.count;
+                reactions.results.add(copy);
+                changed = true;
+            } else if (!result.chosen || result.count < expected.count) {
+                result.flags |= 1;
+                result.chosen = true;
+                result.chosen_order = expected.chosen_order;
+                result.count = Math.max(result.count, expected.count);
+                changed = true;
+            }
+        }
+        final long selfId = getUserConfig().getClientUserId();
+        for (int i = reactions.recent_reactions.size() - 1; i >= 0; i--) {
+            TLRPC.MessagePeerReaction reaction = reactions.recent_reactions.get(i);
+            if (MessageObject.getPeerId(reaction.peer_id) == selfId && inu_findReactionCount(sent.chosen, reaction.reaction) == null) {
+                reactions.recent_reactions.remove(i);
+                changed = true;
+            }
+        }
+        for (int i = 0; i < sent.own.size(); i++) {
+            TLRPC.MessagePeerReaction own = sent.own.get(i);
+            boolean found = false;
+            for (int j = 0; j < reactions.recent_reactions.size() && !found; j++) {
+                TLRPC.MessagePeerReaction reaction = reactions.recent_reactions.get(j);
+                found = MessageObject.getPeerId(reaction.peer_id) == selfId && ReactionsLayoutInBubble.equalsTLReaction(reaction.reaction, own.reaction);
+            }
+            if (!found) {
+                TLRPC.TL_messagePeerReaction copy = new TLRPC.TL_messagePeerReaction();
+                copy.flags = own.flags;
+                copy.big = own.big;
+                copy.peer_id = own.peer_id;
+                copy.reaction = own.reaction;
+                copy.date = own.date;
+                reactions.recent_reactions.add(0, copy);
+                changed = true;
+            }
+        }
+        if (changed && debug) {
+            FileLog.d("InuRx kept sent reactions did=" + dialogId + " mid=" + messageId + " incoming=" + before + " result=" + desu.inugram.helpers.chat.ReactionDebugHelper.describe(reactions) + " from " + desu.inugram.helpers.chat.ReactionDebugHelper.caller());
+        }
+    }
