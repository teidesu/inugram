+    public void inu_ignoreStaleUnreadReactions(long dialogId, int messageId, TLRPC.TL_messageReactions reactions, boolean willCheck) {
+        if (!MessageObject.hasUnreadReactions(reactions)) {
+            return;
+        }
+        if (inu_pendingReactionReads.containsKey(dialogId + "_" + messageId)) {
+            for (int i = 0; i < reactions.recent_reactions.size(); i++) {
+                reactions.recent_reactions.get(i).unread = false;
+            }
+            if (desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled()) {
+                FileLog.d("InuRx ignored unread flags pending read did=" + dialogId + " mid=" + messageId + " from " + desu.inugram.helpers.chat.ReactionDebugHelper.caller());
+            }
+            return;
+        }
+        inu_keepReadReactions(dialogId, messageId, reactions);
+        TLRPC.Message stored = getMessagesStorage().getMessage(dialogId, messageId);
+        if (stored != null) {
+            if (willCheck && !MessageObject.hasUnreadReactions(stored) && MessageObject.hasUnreadReactions(reactions)) {
+                inu_newUnreadReactions.add(dialogId + "_" + messageId);
+            }
+        }
+        if (desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled()) {
+            FileLog.d("InuRx stale unread check did=" + dialogId + " mid=" + messageId + " stored=" + (stored == null ? null : desu.inugram.helpers.chat.ReactionDebugHelper.describe(stored.reactions)) + " stillUnread=" + MessageObject.hasUnreadReactions(reactions));
+        }
+    }
