+    private void inu_repairUnreadReactionsCount(long dialogId, long topicId) {
+        int count = getMessagesStorage().inu_getUnreadReactionsCountSync(dialogId, topicId);
+        if (desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled()) {
+            FileLog.d("InuRx repair did=" + dialogId + " topic=" + topicId + " localCount=" + count + " reload=" + (count != 0));
+        }
+        if (count != 0) {
+            checkUnreadReactionsInternal2(dialogId, topicId, true, false, 0, null);
+        } else {
+            inu_postUnreadReactionsCount(dialogId, topicId);
+        }
+    }
+
+    private void inu_postUnreadReactionsCount(long dialogId, long topicId) {
+        AndroidUtilities.runOnUIThread(() -> {
+            final int count;
+            if (topicId == 0) {
+                TLRPC.Dialog dialog = dialogs_dict.get(dialogId);
+                if (dialog == null) {
+                    return;
+                }
+                count = dialog.unread_reactions_count;
+            } else {
+                TLRPC.TL_forumTopic topic = getTopicsController().findTopic(-dialogId, topicId);
+                if (topic == null) {
+                    return;
+                }
+                count = topic.unread_reactions_count;
+            }
+            getNotificationCenter().postNotificationName(NotificationCenter.dialogsUnreadReactionsCounterChanged, dialogId, topicId, count, null);
+        });
+    }
