+    private boolean inu_needReactionsReloadForUnknownRow(long dialogId, long topicId, int messageId, boolean hasUnreadReaction) {
+        final boolean needReload;
+        final Object stored;
+        if (hasUnreadReaction) {
+            Boolean storedUnread = getMessagesStorage().inu_hasStoredUnreadReactionsSync(dialogId, topicId, messageId);
+            needReload = storedUnread == null || storedUnread;
+            stored = storedUnread;
+        } else {
+            int count = getMessagesStorage().inu_getUnreadReactionsCountSync(dialogId, topicId);
+            needReload = count != 0;
+            stored = count;
+        }
+        if (desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled()) {
+            FileLog.d("InuRx unknown row did=" + dialogId + " topic=" + topicId + " mid=" + messageId + " unread=" + hasUnreadReaction + (hasUnreadReaction ? " storedUnread=" : " localCount=") + stored + " reload=" + needReload);
+        }
+        return needReload;
+    }
