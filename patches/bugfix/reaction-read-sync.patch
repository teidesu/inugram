+    private boolean inu_retryReactionsReloadIfStale(long dialogId, long topicId, int readSeq, ArrayList<Integer> newUnreadMessages) {
+        if (readSeq == inu_getReactionReadSeq(dialogId)) {
+            return false;
+        }
+        if (desu.inugram.helpers.chat.ReactionDebugHelper.isEnabled()) {
+            FileLog.d("InuRx reload raced with read, retrying did=" + dialogId + " topic=" + topicId);
+        }
+        checkUnreadReactionsInternal2(dialogId, topicId, true, false, 0, newUnreadMessages);
+        return true;
+    }
