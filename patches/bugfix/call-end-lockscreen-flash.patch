From: alina sireneva <alina@tei.pet>
Date: Thu, 13 Aug 2026 01:16:50 +0400
Subject: Dont flash the dialogs list over the lockscreen after ending a call

---
 .../telegram/ui/Components/voip/VoIPWindowView.java   | 11 +++++++++++
 .../src/main/java/org/telegram/ui/LaunchActivity.java |  1 +
 2 files changed, 12 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPWindowView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPWindowView.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPWindowView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPWindowView.java
@@ -3,6 +3,7 @@ package org.telegram.ui.Components.voip;
 import android.animation.Animator;
 import android.animation.AnimatorListenerAdapter;
 import android.app.Activity;
+import android.app.KeyguardManager;
 import android.content.Context;
 import android.content.pm.ActivityInfo;
 import android.graphics.PixelFormat;
@@ -129,6 +130,7 @@ public class VoIPWindowView extends FrameLayout {
             VoIPFragment.clearInstance();
 
             if (lockOnScreen) {
+                inu_hideActivityUnderKeyguard();
                 try {
                     WindowManager wm = (WindowManager) activity.getSystemService(Context.WINDOW_SERVICE);
                     wm.removeView(VoIPWindowView.this);
@@ -144,6 +146,7 @@ public class VoIPWindowView extends FrameLayout {
                         notificationsLocker.unlock();
                         AndroidUtilities.unlockOrientation(activity);
                         if (getParent() != null) {
+                            inu_hideActivityUnderKeyguard();
                             WindowManager wm = (WindowManager) activity.getSystemService(Context.WINDOW_SERVICE);
                             setVisibility(View.GONE);
                             try {
@@ -207,8 +210,16 @@ public class VoIPWindowView extends FrameLayout {
 
     }
 
+    private void inu_hideActivityUnderKeyguard() {
+        KeyguardManager km = (KeyguardManager) activity.getSystemService(Context.KEYGUARD_SERVICE);
+        if (km != null && km.isKeyguardLocked()) {
+            activity.getWindow().getDecorView().setVisibility(View.INVISIBLE);
+        }
+    }
+
     public void finishImmediate() {
         if (getParent() != null) {
+            inu_hideActivityUnderKeyguard();
             AndroidUtilities.unlockOrientation(activity);
             WindowManager wm = (WindowManager) activity.getSystemService(Context.WINDOW_SERVICE);
             setVisibility(View.GONE);
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
@@ -7285,6 +7285,7 @@ public class LaunchActivity extends BasePermissionsActivity implements INavigati
     @Override
     protected void onResume() {
         super.onResume();
+        getWindow().getDecorView().setVisibility(View.VISIBLE);
         WidgetMedia.onAppPaused(false);
         isResumed = true;
         PipCoordinator.getInstance().onActivityResume(this);
